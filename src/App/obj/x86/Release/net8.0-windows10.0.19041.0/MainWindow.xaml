<Window x:ConnectionId='1'
    x:Class="FastBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FastBoard"
    xmlns:controls="using:FastBoard.Controls"
    mc:Ignorable="d"
    Title="FastBoard">
    <Grid x:ConnectionId='2'                    >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Grid.ColumnSpan="2">
            <AppBarButton Icon="Add" Label="New" />
            <AppBarToggleButton x:ConnectionId='9' x:Name="ToggleSelect" Icon="SelectAll" Label="Select" Tag="Select"                        />
            <AppBarButton x:ConnectionId='10' Icon="Delete" Label="Delete"                          />
            <AppBarToggleButton x:ConnectionId='11' x:Name="ToggleArrow" Icon="Forward" Label="Arrow" Tag="Arrow"                        />
            <AppBarToggleButton x:ConnectionId='12' x:Name="ToggleDribble" Icon="Shuffle" Label="Dribble" Tag="Dribble"                        />
            <AppBarToggleButton x:ConnectionId='13' x:Name="ToggleCurve" Icon="Edit" Label="Curve" Tag="Curve"                        />
            <AppBarToggleButton x:ConnectionId='14' x:Name="ToggleScreen" Icon="Rotate" Label="Screen" Tag="Screen"                        />
            <AppBarToggleButton x:ConnectionId='15' x:Name="ToggleEraser" Icon="Erase" Label="Eraser" Tag="Eraser"                        />
            <AppBarToggleButton x:ConnectionId='16' x:Name="ToggleShotArc" Icon="EditMirroring" Label="Shot Arc" Tag="ShotArc"                        />
            <AppBarToggleButton x:ConnectionId='17' x:Name="TogglePen" Icon="PenWorkspace" Label="Pen" Tag="Pen"                        />
            <AppBarButton x:ConnectionId='18' Icon="Save" Label="Save"                       />
            <AppBarButton x:ConnectionId='19' Icon="OpenFile" Label="Open"                       />
            <AppBarButton x:ConnectionId='20' Icon="Upload" Label="Export PNG"                    />
            <AppBarButton x:ConnectionId='21' Icon="Video" Label="Export Frames"                       />
            <AppBarButton x:ConnectionId='22' Icon="Play" Label="Play"               />
            <AppBarButton x:ConnectionId='23' Icon="Pause" Label="Pause"                />
            <AppBarButton x:ConnectionId='24' Icon="Back" Label="Prev"               />
            <AppBarButton x:ConnectionId='25' Icon="Forward" Label="Next"               />
            <AppBarButton x:ConnectionId='26' Icon="Upload" Label="Capture Frame"                       />
            <AppBarButton x:ConnectionId='27' Icon="ZoomIn" Label="Zoom In"                 />
            <AppBarButton x:ConnectionId='28' Icon="ZoomOut" Label="Zoom Out"                  />
            <AppBarButton x:ConnectionId='29' Icon="Refresh" Label="Reset View"                    />
        </CommandBar>
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
            <TextBlock Text="Palette" Margin="8,0,0,0"/>
            <ListView x:ConnectionId='5' x:Name="PaletteList" Margin="8" AllowDrop="False"                                                SelectionMode="Single">
                <ListView.Items>
                    <TextBlock Text="sample_data/placeholder1.png"/>
                    <TextBlock Text="sample_data/placeholder2.png"/>
                    <TextBlock Text="sample_data/placeholder3.png"/>
                    <TextBlock Text="Circle Token"/>
                </ListView.Items>
            </ListView>
            <StackPanel Margin="8">
                <TextBlock Text="Status" FontWeight="SemiBold"/>
                <TextBlock Text="Active Tool:"/>
                <TextBlock x:ConnectionId='6'                                                />
                <TextBlock Text="Undo/Redo:"/>
                <TextBlock x:ConnectionId='7'                                           />
                <TextBlock x:ConnectionId='8'                                           />
            </StackPanel>
        </StackPanel>
        <Grid x:ConnectionId='3' Grid.Row="1" Grid.Column="1" x:Name="CanvasGrid" AllowDrop="True"                                                >
            <controls:CourtView x:ConnectionId='4' HalfCourt="True" x:Name="Court"/>
        </Grid>
    </Grid>
</Window>

