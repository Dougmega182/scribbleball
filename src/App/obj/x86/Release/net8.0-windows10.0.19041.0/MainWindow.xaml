<Window
    x:Class="FastBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FastBoard"
    xmlns:controls="using:FastBoard.Controls"
    mc:Ignorable="d"
    Title="FastBoard">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Grid.ColumnSpan="2">
            <AppBarButton Icon="Add" Label="New" />
            <AppBarToggleButton x:ConnectionId='4' Icon="SelectAll" Label="Select" Tag="Select"                        />
            <AppBarButton x:ConnectionId='5' Icon="Delete" Label="Delete"                          />
            <AppBarToggleButton x:ConnectionId='6' Icon="Forward" Label="Arrow" Tag="Arrow"                        />
            <AppBarToggleButton x:ConnectionId='7' Icon="Shuffle" Label="Dribble" Tag="Dribble"                        />
            <AppBarToggleButton x:ConnectionId='8' Icon="Edit" Label="Curve" Tag="Curve"                        />
            <AppBarToggleButton x:ConnectionId='9' Icon="Rotate" Label="Screen" Tag="Screen"                        />
            <AppBarToggleButton x:ConnectionId='10' Icon="Erase" Label="Eraser" Tag="Eraser"                        />
            <AppBarButton x:ConnectionId='11' Icon="Save" Label="Save"                       />
            <AppBarButton x:ConnectionId='12' Icon="OpenFile" Label="Open"                       />
            <AppBarButton x:ConnectionId='13' Icon="Upload" Label="Export PNG"                    />
            <AppBarButton x:ConnectionId='14' Icon="Video" Label="Export Frames"                       />
            <AppBarButton x:ConnectionId='15' Icon="ZoomIn" Label="Zoom In"                 />
            <AppBarButton x:ConnectionId='16' Icon="ZoomOut" Label="Zoom Out"                  />
            <AppBarButton x:ConnectionId='17' Icon="Refresh" Label="Reset View"                    />
        </CommandBar>
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
            <TextBlock Text="Palette" Margin="8,0,0,0"/>
            <Button x:ConnectionId='3' Content="Add Sample Token"                          Margin="8"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1">
            <controls:CourtView x:ConnectionId='2' HalfCourt="True" x:Name="Court"/>
        </Grid>
    </Grid>
</Window>

