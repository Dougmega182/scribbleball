<Window
    x:Class="FastBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FastBoard"
    xmlns:controls="using:FastBoard.Controls"
    mc:Ignorable="d"
    Title="FastBoard">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Grid.ColumnSpan="2">
            <AppBarButton Icon="Add" Label="New" />
            <AppBarToggleButton Icon="SelectAll" Label="Select" Tag="Select" Checked="OnToolToggle" />
            <AppBarButton Icon="Delete" Label="Delete" Click="OnDeleteSelected" />
            <AppBarToggleButton Icon="Forward" Label="Arrow" Tag="Arrow" Checked="OnToolToggle" />
            <AppBarToggleButton Icon="Shuffle" Label="Dribble" Tag="Dribble" Checked="OnToolToggle" />
            <AppBarToggleButton Icon="Edit" Label="Curve" Tag="Curve" Checked="OnToolToggle" />
            <AppBarToggleButton Icon="Rotate" Label="Screen" Tag="Screen" Checked="OnToolToggle" />
            <AppBarToggleButton Icon="Erase" Label="Eraser" Tag="Eraser" Checked="OnToolToggle" />
            <AppBarButton Icon="Save" Label="Save" Click="OnSavePlaybook"/>
            <AppBarButton Icon="OpenFile" Label="Open" Click="OnOpenPlaybook"/>
            <AppBarButton Icon="Upload" Label="Export PNG" Click="OnExportPng"/>
            <AppBarButton Icon="Video" Label="Export Frames" Click="OnExportFrames"/>
            <AppBarButton Icon="ZoomIn" Label="Zoom In" Click="OnZoomIn"/>
            <AppBarButton Icon="ZoomOut" Label="Zoom Out" Click="OnZoomOut"/>
            <AppBarButton Icon="Refresh" Label="Reset View" Click="OnZoomReset"/>
        </CommandBar>
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
            <TextBlock Text="Palette" Margin="8,0,0,0"/>
            <Button Content="Add Sample Token" Click="OnAddSampleToken" Margin="8"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1">
            <controls:CourtView HalfCourt="True" x:Name="Court"/>
        </Grid>
    </Grid>
</Window>